# ---- Database (Postgres + pgvector) ----
# Inside docker-compose the host is the service name `db`.
DATABASE_URL=postgresql+psycopg://meeting:meeting@db:5432/meeting

# ---- Redis (Celery broker + result backend) ----
REDIS_URL=redis://redis:6379/0

# ---- Auth ----
# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Transcription (Deepgram) ----
DEEPGRAM_API_KEY=your-deepgram-api-key

# ---- Answering LLM (Groq) ----
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Embeddings (OpenAI) ----
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Storage ----
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=500

# ---- Frontend ----
# Base URL the browser uses to reach the backend.
NEXT_PUBLIC_API_BASE=http://localhost:8000
